---
import GoogleMap from "../components/Maps";

const cities = [
    { name: "Gdańsk", distance: "135" },
    { name: "Bydgoszcz", distance: "139" },
    { name: "Toruń", distance: "177" },
    { name: "Elbląg", distance: "188" },
    { name: "Szczecin", distance: "271" },
    { name: "Poznań", distance: "273" },
    { name: "Olsztyn", distance: "300" },
    { name: "Warszawa", distance: "442" },
];

const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
---

<section
    id='map-section'
    class='flex flex-col md:flex-row text-white relative bg-brand-grey-400 scroll-m-24 overflow-hidden h-[600px]'
>
    <!-- Gradient overlays for desktop only -->
    <div
        class='hidden md:block bg-gradient-to-r from-brand-grey-400/100 to-brand-grey-400/100 absolute inset-0 w-1/4 h-full z-10 pointer-events-none'
    >
    </div>

    <div
        class='hidden md:block bg-gradient-to-r from-brand-grey-400/100 via-brand-grey-400/90 to-brand-grey-400/0 absolute inset-0 w-1/4 h-full z-10 left-1/4 pointer-events-none'
    >
    </div>

    <!-- Left Column: City List -->
    <div
        class='w-full md:w-[400px] md:shrink-0 items-center md:items-end justify-center py-8 md:pb-20 flex order-2 md:order-1'
    >
        <ul
            class='grid grid-cols-2 md:block gap-x-8 md:gap-x-0 md:space-y-4 z-20'
        >
            {
                cities.map((city) => (
                    <li class='text-left text-[16px] sm:text-[18px] lg:text-[24px] font-normal whitespace-nowrap leading-[32px] text-brand-white-100'>
                        {city.name} -{" "}
                        <span class='text-brand-green-100'>
                            {city.distance}
                        </span>{" "}
                        km
                    </li>
                ))
            }
        </ul>
    </div>

    <!-- Right Column: Google Map -->
    <div class='w-full h-full relative order-1 md:order-2'>
        <!-- mapa jako tło -->
        <div class='absolute inset-0'>
            <GoogleMap
                client:only='react'
                apiKey={apiKey}
                className='w-full h-full'
            />
        </div>

        <!-- gradient przyciemniający mapę od lewej -->
        <div
            class='absolute inset-0 bg-gradient-to-r from-black/50 via-black/30 to-transparent z-10 pointer-events-none'
        >
        </div>

        <!-- Title on Map -->
        <div
            class='absolute top-1/8 left-1/2 -translate-x-1/2 -translate-y-1/2 md:top-[15%] md:left-[35%] text-center z-20 pointer-events-none'
        >
            <h2
                class='text-[36px] font-onest font-semibold text-brand-white-100 leading-[24px] text-shadow-sm text-shadow-brand-black-50'
            >
                Ukojenie
            </h2>
            <p
                class='text-[20px] text-brand-green-100 font-serif font-semibold italic leading-[24px] mt-2 text-shadow-sm text-shadow-brand-black-50'
            >
                w sercu natury
            </p>
        </div>
    </div>
</section>
