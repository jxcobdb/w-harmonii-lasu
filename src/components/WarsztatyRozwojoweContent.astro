---
import SubpageCarousel from "./SubpageCarousel/SubpageCarousel";

const photos: string[] = [
    "/images/warsztaty-rozwojowe/karuzela-rozwojowe-1.png",
    "/images/warsztaty-rozwojowe/karuzela-rozwojowe-2.png",
    "/images/warsztaty-rozwojowe/karuzela-rozwojowe-3.png",
    "/images/warsztaty-rozwojowe/karuzela-rozwojowe-4.png",
];
---

<section
    class='bg-brand-white-125 px-[40px] pt-20 md:pt-30 scroll-m-10'
    id='welcome-carousel'
    style={{
        backgroundImage: 'url("/images/backgrounds/pattern_warsztaty.png")',
        backgroundRepeat: "no-repeat",
        backgroundPosition: "center",
        backgroundSize: "cover",
    }}
>
    <div
        class='mx-auto flex max-w-[var(--container-max-width)] flex-col gap-10'
    >
        <div class='grid gap-8 lg:grid-cols-2'>
            {/* LEWA KOLUMNA – TEKST */}
            <div
                class='flex flex-col gap-6 transition-opacity duration-300 items-start pr-10'
            >
                <h2
                    class='font-brand-serif font-semibold italic text-[35px] md:text-[50px] lg:text-[55px] xl:text-[70px] text-brand-black-100 text-center lg:text-start w-full'
                >
                    Na czym to
                    <span class='text-brand-green-125'> polega?</span>
                </h2>

                <div class='flex flex-col gap-3 lg:text-left text-center'>
                    <h3
                        class='font-onest font-semibold text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] text-brand-black-50 mb-5'
                    >
                        Wspólna droga do lepszego zrozumienia.
                    </h3>

                    <p
                        class='lg:text-[16px] xl:text-[18px] leading-relaxed text-brand-grey-350 font-semibold'
                    >
                        <span class='text-brand-green-125'
                            >W harmonii lasu to ośrodek w samym sercu lasu
                        </span>
                        - bez sąsiadów, bez zgiełku, z Brdą tuż za płotem i śpiewem
                        ptaków zamiast budzika. Dostaniesz tu wszystko co potrzebne,
                        by wrócić do siebie w naturalnym rytmie z pełnym zapleczem.
                    </p>
                </div>

                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Naszym gościom oferujemy przestrzenie, które wspierają
                        głęboką pracę:
                    </h4>

                    <ul class='list-dots'>
                        <li>
                            12 pokoi (10 z własną łazienką, 2 ze wspólną, 2–4
                            osobowych) ciche i funkcjonalne, ciepłe, i spokojne
                            – wspierają odcięcie od bodźców i prawdziwy
                            odpoczynek
                        </li>
                        <li>
                            Pyszna, domowa kuchnia w formie bufetu - mięsna,
                            wegetariańska, wegańska, a za dopłatą również
                            specjalna
                        </li>
                        <li>
                            Możliwość posiłków „na wynos” przy pracy w terenie
                            lub ciszy
                        </li>
                        <li>
                            Sala warsztatowa w stodole (60 m²) cała z drewna, na
                            uboczu wyposażona w maty do jogi, poduszki
                            medytacyjne i koce
                        </li>
                        <li>Sala wykładowa (30 m²) do zajęć teoretycznych</li>
                        <li>
                            Ponad 2 ha teren z ogrodem, stawem, rzeką i polaną
                            do ćwiczeń, medytacji, pracy w ruchu, sesji w
                            naturze
                        </li>
                        <li>
                            Hamaki nad stawem, leżaki, altana do kontemplacji i
                            wyciszenia
                        </li>
                        <li>
                            Przestronny taras i wiata ogniskowa – miejsca
                            rozmów, spotkań w kręgu, wieczornych ognisk
                        </li>
                        <li>
                            Sauna sucha z możliwością kąpieli w rzece,
                            wspierających procesy oczyszczania i pracę z ciałem
                        </li>
                    </ul>
                </div>

                <p
                    class='lg:text-[16px] xl:text-[18px] leading-relaxed text-brand-grey-350 font-semibold'
                >
                    Jeśli organizujesz warsztaty rozwojowe, terapeutyczne,
                    odosobnieniowe, retreaty duchowe, kręgi kobiet, sesje pracy
                    z ciałem, czy umysłem – znajdziesz u nas nie tylko
                    przestrzeń, ale też atmosferę, która naturalnie wspiera
                    głęboką pracę i transformację.
                </p>

                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Dodatkowe zajęcia:
                    </h4>

                    <ul class='list-dots'>
                        <li>Kajaki, rowery, hamaki, książki</li>
                        <li>
                            Sesje Access Bars i Ustawień Systemowych wg. Berta
                            Hellingera
                        </li>
                        <li>Medytacje i kąpiele leśne</li>
                    </ul>
                </div>
                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Co jeszcze oferujemy organizatorom?
                    </h4>

                    <ul class='list-dots'>
                        <li>
                            Pomoc w organizacji pobytu: zakwaterowanie, posiłki,
                            przestrzenie
                        </li>
                        <li>
                            Elastyczność godzinowa i życzliwe podejście do
                            potrzeb grupy
                        </li>
                        <li>
                            Dostęp do sprzętu: rzutnik, ekran, podstawowe
                            materiały
                        </li>
                        <li>
                            Możliwość zarezerwowania całości tylko dla Twojej
                            grupy (min. 16 osób)
                        </li>
                        <li>
                            Rabat 10% dla grup powyżej 20 osób lub przy pobytach
                            powyżej 6 dni.
                        </li>
                    </ul>
                </div>
                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Chcesz zorganizować swój warsztat?
                    </h4>

                    <p
                        class='lg:text-[16px] xl:text-[18px] leading-relaxed text-brand-grey-350 font-semibold'
                    >
                        Skontaktuj się z nami – wspólnie dopasujemy terminy,
                        przestrzeń, wyżywienie i szczegóły
                        organizacyjne. Jesteśmy tu, by Twoje wydarzenie mogło
                        się naprawdę zadziać – w zaopiekowaniu, ciszy i
                        harmonii, w lesie.
                    </p>
                </div>

                <a
                    href='/rezerwacja'
                    class='mt-6 group inline-flex items-center gap-2 font-brand-sans font-semibold text-brand-black-100 text-[24px] underline decoration-transparent hover:decoration-brand-black-100 transition'
                >
                    Zapytaj o szczegóły!
                    <img
                        src='/icons/arrow-corner.svg'
                        alt='Arrow Right'
                        class='w-4 h-4 group-hover:-rotate-45 transition-transform'
                        style={{ filter: "brightness(0) saturate(100%)" }}
                    />
                </a>
            </div>

            {/* PRAWA KOLUMNA – ZDJĘCIA */}
            <div
                class='flex flex-col justify-start items-center gap-5 lg:gap-20'
            >
                <img
                    src='/images/warsztaty-rozwojowe/rozwojowe-1.png'
                    alt='Praca z psem w terenie'
                    class='w-[800px]'
                    loading='lazy'
                />
                <img
                    src='images/warsztaty-rozwojowe/rozwojowe-2.png'
                    alt='Pies odpoczywający na terenie ośrodka'
                    class='w-[650px]'
                    loading='lazy'
                />
            </div>
        </div>
    </div>
    <SubpageCarousel images={photos} client:only />
</section>
