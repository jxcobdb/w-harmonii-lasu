---
import SubpageCarousel from "./SubpageCarousel/SubpageCarousel";

const photos: string[] = [
    "/images/oferta/karuzela-oferta-1.png",
    "/images/oferta/karuzela-oferta-2.png",
    "/images/oferta/karuzela-oferta-3.png",
    "/images/oferta/karuzela-oferta-4.png",
    "/images/oferta/karuzela-oferta-5.png",
    "/images/oferta/karuzela-oferta-6.png",
    "/images/oferta/karuzela-oferta-7.png",
    "/images/oferta/karuzela-oferta-8.png",
];
---

<section
    style={{
        backgroundImage: 'url("/images/backgrounds/pattern_oferta.png")',
        backgroundRepeat: "no-repeat",
        backgroundPosition: "center",
        backgroundSize: "cover",
    }}
>
    <div class='px-[40px] py-20 md:py-30 scroll-m-10' id='welcome-carousel'>
        <div
            class='mx-auto flex max-w-[var(--container-max-width)] flex-col gap-10'
        >
            <div class='grid gap-8 lg:grid-cols-2'>
                <div
                    class='flex flex-col gap-6 transition-opacity duration-300 items-center lg:items-start'
                >
                    <h2
                        class='font-brand-serif font-semibold italic text-[35px] md:text-[50px] lg:text-[55px] xl:text-[70px] text-brand-black-100 lg:text-left text-center mb-4'
                    >
                        <span class='text-brand-green-125'
                            >„W harmonii lasu”</span
                        >
                        miejsce odpoczynku i rozwoju w sercu natury
                    </h2>

                    <div
                        class='flex flex-col gap-4 lg:text-[16px] xl:text-[18px] leading-relaxed text-brand-grey-350 font-semibold lg:text-left text-center mb-4'
                    >
                        <p>
                            <span class='text-brand-green-125 font-bold'>
                                Zapraszamy do wyjątkowego miejsca położonego w
                                samym sercu lasu, bez sąsiadów, z rzeką Brdą
                                niemal za płotem
                            </span>
                            - to idealna przestrzeń do regeneracji i wypoczynku.
                            Cisza, spokój, dużo zieleni czasem dzikich zwierząt i
                            domowa atmosfera - jak u przyjaciół na wsi.
                        </p>
                    </div>

                    <button
                        class='group inline-flex items-center gap-2 font-brand-sans font-semibold text-brand-black-100 text-[24px] underline decoration-transparent hover:decoration-brand-black-100 transition'
                    >
                        Skontaktuj się z nami!{" "}
                        <img
                            src='/icons/arrow-corner.svg'
                            alt='Arrow Right'
                            class='w-4 h-4 group-hover:-rotate-45 transition-transform'
                            style={{ filter: "brightness(0) saturate(100%)" }}
                        />
                    </button>
                </div>
                <div
                    class='overflow-hidden max-w-[650px] transition-opacity duration-300 flex lg:block items-center justify-self-center lg:justify-self-end'
                >
                    <img
                        src='/images/oferta/oferta-welcome.png'
                        alt='oferta welcome section'
                        class=''
                        loading='lazy'
                    />
                </div>
            </div>
        </div>
    </div>
    <div class='px-[40px] py-16'>
        <div class='max-w-[var(--container-max-width)] mx-auto'>
            <h2
                class='font-brand-serif font-semibold italic text-[35px] md:text-[50px] lg:text-[55px] xl:text-[70px] text-brand-black-100 lg:text-left text-center mb-8'
            >
                Naszym gościom
                <span class='text-brand-green-125'>oferujemy:</span>
            </h2>
            <h3
                class='font-onest font-semibold leading-[24px] text-center lg:text-left text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px]'
            >
                Miejsce
                <span class='text-brand-green-125'>przyjazne wszystkim</span>
                oraz
                <span class='text-brand-green-125'
                    >20-letnie doświadczenie!</span
                >
            </h3>
            <div class='py-10 lg:py-22 grid grid-cols-1 lg:grid-cols-2'>
                <div class='pr-10'>
                    <div class='mb-20'>
                        <h4
                            class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                        >
                            Noclegi w prostocie:
                        </h4>
                        <ul class='list-with-icon'>
                            <li>12 pokoi (10 z własną łazienką, 2 ze wspólną) -
                                max 34 os.
                            </li>
                            <li>Pokoje 2–4 osobowe, ciche i funkcjonalne</li>
                            <li>Wyposażenie: łóżka, szafy, białe ściany,
                                drewniane akcenty, malowane akwarele
                            </li>
                            <li>Ciepłe, wygodne i spokojne</li>
                            <li>Wspierają odcięcie od bodźców i prawdziwy
                                odpoczynek
                            </li>
                        </ul>
                    </div>
                    <div class='mb-20'>
                        <h4
                            class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                        >
                            Wyżywienie, które odżywia:
                        </h4>
                        <p
                            class='text-brand-grey-400 font-onest font-semibold leading-[24px] text-[14px] lg:text-[16px] xl:text-[18px] mb-2'
                        >
                            Pyszna, domowa kuchnia w formie bufetu w wersji:
                        </p>
                        <ul class='list-with-icon'>
                            <li>tradycyjna, wegetariańska, wegańska</li>
                            <li>Za dopłatą również: bezglutenowa, bez laktozy,
                                post warzywno-owocowy (dieta Dąbrowskiej) i inne
                            </li>
                            <li>Możliwość posiłków „na wynos” w teren</li>
                        </ul>
                    </div>
                    <div class='mb-20'>
                        <h4
                            class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                        >
                            Teren wokół:
                        </h4>
                        <ul class='list-with-icon'>
                            <li>Ponad 2 ha terenu z ogrodem, stawem i polaną, z
                                rzeką tuż za płotem
                            </li>
                            <li>Przestrzeń do relaksu w hamakach lub w ogrodowej
                                altanie
                            </li>
                            <li>Wiata ogniskowa do wieczornych spotkań</li>
                            <li>Sauna sucha + możliwość kąpieli w rzece</li>
                            <li>Plac zabaw dla najmłodszych</li>
                            <li>Boisko sportowe do siatkówki i badmintona, kosz
                                do koszykówki
                            </li>
                        </ul>
                    </div>
                    <div class='mb-20'>
                        <h4
                            class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                        >
                            Wewnętrzna część domu:
                        </h4>
                        <ul class='list-with-icon'>
                            <li>Stołówka z domowym ciepłem</li>
                            <li>Hall z książkami - kącik do rozmów i wyciszenia
                            </li>
                            <li>Sprawny internet</li>
                            <li>Kuchnia do przygotowania dodatkowych posiłków
                                lub samodzielnego żywienia
                            </li>
                            <li>Sala warsztatowa 60m² w drewnianej stodole</li>
                        </ul>
                    </div>
                    <div class='mb-20'>
                        <h4
                            class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                        >
                            Dodatkowe zajęcia:
                        </h4>
                        <ul class='list-with-icon'>
                            <li>Spływy kajakowe</li>
                            <li>Rowery i kilometry leśnych ścieżek</li>
                            <li>Sesje Access Bars i Ustawień Systemowych 
                                wg. Berta Hellingera
                            </li>
                            <li>Medytacje i kąpiele leśne</li>
                            <li>Grzybobranie i dostęp do suszarni</li>
                            <li>Wędkowanie na dzierżawionym jeziorze z
                                możliwością wynajęcia łódki z silnikiem
                            </li>
                        </ul>
                    </div>
                </div>
                <div
                    class='flex flex-col justify-center lg:justify-between items-center lg:items-end gap-5 lg:gap-0'
                >
                    <img
                        src='/images/oferta/oferta-content-1.png'
                        alt='oferta content photo 1'
                        class='w-[700px]'
                        loading='lazy'
                    />
                    <img
                        src='/images/oferta/oferta-content-2.png'
                        alt='oferta content photo 2'
                        class='w-[700px]'
                        loading='lazy'
                    />
                    <img
                        src='/images/oferta/oferta-content-3.png'
                        alt='oferta content photo 3'
                        class='w-[700px]'
                        loading='lazy'
                    />
                </div>
            </div>
        </div>
    </div>
    <div class='px-[40px]'>
        <div class='max-w-[var(--container-max-width)] mx-auto'>
            <h2
                class='font-brand-serif font-semibold italic text-[35px] md:text-[50px] lg:text-[55px] xl:text-[70px] text-brand-black-100 lg:text-left text-center'
            >
                Cennik:
            </h2>
            <div class='py-5 grid grid-cols-1 lg:grid-cols-2'>
                <div class='py-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                    >
                        Usługa:
                    </h4>
                    <ul class='list-with-icon mb-20'>
                        <li>Nocleg z pełnym wyżywieniem</li>
                        <li>Sam nocleg</li>
                        <li>Dopłata do pokoju jednoosobowego</li>
                        <li>Zwierzęta</li>
                        <li>Dieta specjalna (BG, BL, Dąbrowska itp.)</li>
                        <li>Pakiet kajakowy lub wędkarski</li>
                        <li>Rabat przy pobycie >7 dni lub grupie >20 os.</li>
                    </ul>
                </div>
                <div class='py-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 leading-[24px] md:text-[18px] lg:text-[20px] xl:text-[24px] mb-5'
                    >
                        Cena brutto:
                    </h4>
                    <ul class='list-no-icon mb-20' style=''>
                        <li>280 zł / osoba / doba</li>
                        <li>130 zł / osoba / doba</li>
                        <li>+50 zł / doba</li>
                        <li>30 zł / doba</li>
                        <li>+30 zł / dzień</li>
                        <li>od 120 zł / osoba</li>
                        <li>-10%</li>
                    </ul>
                </div>
            </div>
            <a
                class='group inline-flex items-center gap-2 font-brand-sans font-semibold text-brand-black-100 text-[24px] underline decoration-transparent hover:decoration-brand-black-100 transition'
            >
                Skontaktuj się z nami!
                <img
                    src='/icons/arrow-corner.svg'
                    alt='Arrow Right'
                    class='w-4 h-4 group-hover:-rotate-45 transition-transform'
                    style={{ filter: "brightness(0) saturate(100%)" }}
                />
            </a>
        </div>
    </div>
    <SubpageCarousel images={photos} client:only />
</section>
