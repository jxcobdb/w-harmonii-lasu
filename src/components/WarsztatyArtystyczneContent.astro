---
import SubpageCarousel from "./SubpageCarousel/SubpageCarousel";

const photos: string[] = [
    "/images/warsztaty-artystyczne/karuzela-artystyczne-1.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-2.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-3.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-4.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-5.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-6.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-7.png",
    "/images/warsztaty-artystyczne/karuzela-artystyczne-8.png",
];
---

<section
    class='bg-brand-white-125 px-[40px] pt-20 md:pt-30 scroll-m-10'
    id='welcome-carousel'
    style={{
        backgroundImage: 'url("/images/backgrounds/pattern_warsztaty.png")',
        backgroundRepeat: "no-repeat",
        backgroundPosition: "center",
        backgroundSize: "cover",
    }}
>
    <div
        class='mx-auto flex max-w-[var(--container-max-width)] flex-col gap-10'
    >
        <div class='grid gap-8 lg:grid-cols-2'>
            {/* LEWA KOLUMNA – TEKST */}
            <div
                class='flex flex-col gap-6 transition-opacity duration-300 items-start pr-10'
            >
                <h2
                    class='font-brand-serif font-semibold italic text-[35px] md:text-[50px] lg:text-[55px] xl:text-[70px] text-brand-black-100 lg:text-left text-center w-full'
                >
                    Na czym to
                    <span class='text-brand-green-125'> polega?</span>
                </h2>

                <div class='flex flex-col gap-3 w-full'>
                    <h3
                        class='font-onest font-semibold text-[16px] md:text-[18px] lg:text-[20px] xl:text-[24px] text-brand-black-50 lg:text-left text-center mb-5'
                    >
                        Twórz z serca – wśród drzew, w zgodzie z naturą
                    </h3>
                </div>
                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Naszym gościom oferujemy:
                    </h4>

                    <ul class='list-dots'>
                        <li>Zakwaterowanie dla max. 34 osób w 12 pokojach</li>
                        <li>
                            Domowe, sezonowe jedzenie (również wege, wegan, a w
                            razie potrzeby diety specjalne)
                        </li>
                        <li>
                            Kuchnię do przygotowania dodatkowych posiłków lub
                            samodzielnego żywienia
                        </li>
                        <li>
                            Ponad 2 ha teren z ogrodem, stawem, rzeką i polaną
                        </li>
                        <li>Saunę suchą nad samą rzeką</li>
                        <li>Sprawny internet satelitarny</li>
                    </ul>
                </div>
                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Przestrzeń do tworzenia:
                    </h4>

                    <ul class='list-dots'>
                        <li>
                            Drewniana sala warsztatowa (60 m²) z możliwością
                            pracy przy sztalugach lub stołach
                        </li>
                        <li>
                            Naturalne światło dzienne + możliwość zaciemnienia
                            (np. przy fotografii)
                        </li>
                        <li>
                            Naturalna przestrzeń w ogrodzie lub w lesie na
                            plenery malarskie czy fotograficzne
                        </li>
                        <li>Dobrze oświetloną salę warsztatową (30m²)</li>
                        <li>
                            Przestronny taras i wiata ogniskowa – miejsce do
                            wspólnego rysowania, przędzenia, malowania, dowolnej
                            twórczości
                        </li>
                    </ul>
                </div>
                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Dodatkowe zajęcia:
                    </h4>

                    <ul class='list-dots'>
                        <li>Kajaki, rowery, hamaki, książki</li>
                        <li>
                            Sesje Access Bars i Ustawień Systemowych wg. Berta
                            Hellingera
                        </li>
                        <li>Medytacje i kąpiele leśne</li>
                    </ul>
                </div>
                <p
                    class='lg:text-[16px] xl:text-[18px] leading-relaxed text-brand-grey-350 font-semibold'
                >
                    Zorganizuj u nas warsztaty malarskie, fotograficzne,
                    pisarskie, muzyczne, taneczne czy rzemieślnicze. Tu każdy
                    głos, kolor i ruch znajdzie przestrzeń do wybrzmienia.
                </p>

                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Co jeszcze oferujemy organizatorom?
                    </h4>

                    <ul class='list-dots'>
                        <li>
                            Pomoc w organizacji pobytu: zakwaterowanie, posiłki,
                            przestrzenie
                        </li>
                        <li>
                            Elastyczność godzinowa i życzliwe podejście do
                            potrzeb grupy
                        </li>
                        <li>
                            Dostęp do sprzętu: rzutnik, ekran, podstawowe
                            materiały
                        </li>
                        <li>
                            Możliwość zarezerwowania całości tylko dla Twojej
                            grupy (min. 16 osób)
                        </li>
                        <li>
                            Rabat 10% dla grup powyżej 20 osób lub przy pobytach
                            powyżej 6 dni.
                        </li>
                    </ul>
                </div>
                <div class='mt-6 flex flex-col gap-5'>
                    <h4
                        class='font-onest font-semibold text-brand-black-50 md:text-[18px] lg:text-[20px] xl:text-[24px]'
                    >
                        Chcesz zorganizować swój warsztat?
                    </h4>

                    <p
                        class='lg:text-[16px] xl:text-[18px] leading-relaxed text-brand-grey-350 font-semibold'
                    >
                        Skontaktuj się z nami – wspólnie dopasujemy terminy,
                        przestrzeń, wyżywienie i szczegóły
                        organizacyjne. Jesteśmy tu, by Twoje wydarzenie mogło
                        się naprawdę zadziać – w zaopiekowaniu, ciszy i
                        harmonii, w lesie.
                    </p>
                </div>

                <a
                    href='/rezerwacja'
                    class='mt-6 group inline-flex items-center gap-2 font-brand-sans font-semibold text-brand-black-100 text-[24px] underline decoration-transparent hover:decoration-brand-black-100 transition'
                >
                    Zapytaj o szczegóły!
                    <img
                        src='/icons/arrow-corner.svg'
                        alt='Arrow Right'
                        class='w-4 h-4 group-hover:-rotate-45 transition-transform'
                        style={{ filter: "brightness(0) saturate(100%)" }}
                    />
                </a>
            </div>

            {/* PRAWA KOLUMNA – ZDJĘCIA */}
            <div
                class='flex flex-col justify-start items-center gap-5 lg:gap-20'
            >
                <img
                    src='/images/warsztaty-artystyczne/artystyczne-1.png'
                    alt='Praca z psem w terenie'
                    class='w-[800px]'
                    loading='lazy'
                />
                <img
                    src='/images/warsztaty-artystyczne/artystyczne-2.png'
                    alt='Pies odpoczywający na terenie ośrodka'
                    class='w-[650px]'
                    loading='lazy'
                />
            </div>
        </div>
    </div>
    <SubpageCarousel images={photos} client:only />
</section>
