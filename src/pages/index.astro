---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScrolledSection from "../components/ScrolledSection.astro";
import VerticalCarousel from "../components/VerticalCarousel/VerticalCarousel";
import WelcomeCarousel from "../components/WelcomeCarousel/WelcomeCarousel";
import Workshops from "../components/Workshops";
import SocialSection from "../components/SocialSection";
import NavigationGrid from "../components/NavigationGrid.astro";
import Map from "../components/Map.astro";
---

<Layout>
  <Header variant={1} />
  <WelcomeCarousel client:only='react' />
  <ScrolledSection />
  <VerticalCarousel client:only='react' />
  <Workshops client:only='react' />
  <SocialSection client:load />
  <Map />
  <NavigationGrid />
</Layout>
